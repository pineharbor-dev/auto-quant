# =============================================================================
# auto-quant 运行配置（Docker 部署）
#
# `up.sh` 会在首次运行时自动生成这个文件（并填充随机密钥），
# 所以**通常你不需要手动创建它**。这个模板是给你改配置时对照用的。
#
#   cp .env.example .env   # 手动创建（不推荐，密钥需要你自己生成）
# =============================================================================


# -----------------------------------------------------------------------------
# 必填：三个密钥
#
# up.sh 会自动生成。**如果手动创建这个文件，这三项必须自己填。**
# 生成方式：
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   openssl rand -hex 32
#
# ⚠️ 不要留空让系统自动生成。首次启动自动生成的主密钥会写进 data/ 目录，
#    而 data/ 里同时存着加密后的交易所凭据 —— 两样放在一起等于明文凭据。
# -----------------------------------------------------------------------------
MASTER_KEY=
JWT_SECRET=

# 首次启动创建管理员账户用的凭据。
#
# up.sh 会自动生成并打印。**系统没有注册入口** —— 管理员账号只在服务首次
# 启动时创建一次，之后可以在控制台的「操作员账户」里修改用户名与密码。
#
# 用户名也随机生成（而不是固定 admin）：固定的用户名等于把登录所需的两半信息
# 送出去一半，安全性就只剩密码一道防线。
#
# 图省事的话可以直接改成你自己记得住的，首次启动就会用这组。
# 忘记密码时执行 ./up.sh reset-password 可重置为这里的值。
ADMIN_USERNAME=

ADMIN_PASSWORD=


# -----------------------------------------------------------------------------
# 交易环境 —— 最容易出错的一项
#
# false = 实盘（真实资金）    true = 币安 Demo 模拟盘
#
# 两者**界面完全一样**，配错了不会报错，只是交易悄悄跑到错误的环境上。
# 首次部署建议先保持 true 跑通，确认无误后再改 false。
# -----------------------------------------------------------------------------
BINANCE_USE_TESTNET=true

# true 时只模拟下单、不碰交易所（用于纯演示）
DRY_RUN=false

# 全局熔断：true 时服务端拒绝启动任何机器人
GLOBAL_TRADING_DISABLED=false


# -----------------------------------------------------------------------------
# 网络与端口
# -----------------------------------------------------------------------------
PORT=27137

# 宿主机绑定地址。
#   127.0.0.1 —— 只本机可访问（默认，最安全；公网访问请走反向代理）
#   0.0.0.0   —— 公网可直接访问（除非前面有防火墙，否则不要这么设）
BIND_ADDRESS=127.0.0.1

# 日志级别：debug | info | warn | error
LOG_LEVEL=info


# -----------------------------------------------------------------------------
# 镜像与存储
# -----------------------------------------------------------------------------
# 锁定版本时改成具体 tag，例如 ghcr.io/laolaoshiren/auto-quant:v0.2.0
AUTOQUANT_IMAGE=ghcr.io/laolaoshiren/auto-quant:latest

# 容器内数据目录。**不要改**，改了要和 docker-compose.yml 的卷映射一起改。
DATA_DIR=./data
DB_FILE=autoquant.sqlite


# -----------------------------------------------------------------------------
# 可选：允许访问的内网 LLM 端点
#
# 自定义模型端点的 baseUrl 默认**拒绝一切内网 / 回环 / 链路本地地址**。
# 这是刻意的：控制台通常挂在反向代理后面，否则任何能登录的人都可以让服务端
# 去请求 http://169.254.169.254/latest/meta-data/iam/security-credentials/，
# 把云主机的临时凭据读出来。
#
# 自建网关、私有部署、本机推理服务是**受支持**的场景，但每个目标必须在这里
# 逐个显式登记。写法：
#
#     172.19.0.1        精确主机
#     172.19.0.0/16     IPv4 CIDR
#     .corp.lan         域名后缀
#     my-gateway        精确主机名
#
# 逗号或空白分隔。登记一个目标**不会**顺带放行云元数据地址，
# 也**不会**放行同一网段里的其他主机。
#
# ⚠️ 容器部署时注意：容器里的 `127.0.0.1` 是**容器自己**，不是宿主机。
#    要连宿主机上的模型服务，用 `host.docker.internal`（或在 compose 里配
#    `network_mode: host`），并把那个主机名登记到这里。
#
# 示例：
#   ALLOW_PRIVATE_LLM_HOSTS=172.19.0.1
#   ALLOW_PRIVATE_LLM_HOSTS=host.docker.internal, .corp.lan
# -----------------------------------------------------------------------------
ALLOW_PRIVATE_LLM_HOSTS=


# -----------------------------------------------------------------------------
# 可选：HTTP 代理
#
# 服务器所在网络访问币安或 LLM 接口受限时使用。
# 注意：币安对 API Key 有 IP 白名单，走代理后出口 IP 变了，
#       需要在币安后台把代理的出口 IP 加进白名单。
# -----------------------------------------------------------------------------
# HTTPS_PROXY=http://127.0.0.1:7890
