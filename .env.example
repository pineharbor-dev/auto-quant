# ---------------------------------------------------------------------------
# auto-quant environment template.  Copy to `.env` and fill in.
# ---------------------------------------------------------------------------

# --- Server ---------------------------------------------------------------
PORT=27137
HOST=127.0.0.1
LOG_LEVEL=info

# --- Storage --------------------------------------------------------------
# SQLite file. Relative paths resolve against the repository root.
DATA_DIR=./data
DB_FILE=autoquant.sqlite

# --- Secrets --------------------------------------------------------------
# 32-byte key used to encrypt exchange API secrets at rest (AES-256-GCM).
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If unset, a key is generated on first boot and stored in data/.master.key
MASTER_KEY=

# Signs session JWTs. Generate the same way as MASTER_KEY.
JWT_SECRET=

# --- First-run bootstrap --------------------------------------------------
# Credentials for the administrator account created on first boot.
#
# There is NO registration endpoint: the account is created exactly once, and
# these values double as the recovery target for `./up.sh reset-password`.
#
# Both default to random values (printed once to the console / container logs).
# The username is random on purpose — a fixed `admin` hands an attacker half of
# what they need to log in, leaving the password as the only line of defence.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# --- Binance --------------------------------------------------------------
# Use the testnet while developing. Set to false only when you are ready to
# trade real money.
BINANCE_USE_TESTNET=true

# Optional shared HTTP proxy for Binance + LLM traffic (e.g. http://127.0.0.1:7890)
# HTTPS_PROXY=

# --- LLM: private / internal endpoints ------------------------------------
# Custom model endpoints (baseUrl) refuse every loopback / private / link-local
# address by default. That is deliberate: the console may sit behind a reverse
# proxy, and the server would otherwise happily fetch
# http://169.254.169.254/latest/meta-data/iam/security-credentials/ on behalf of
# anyone who can log in — handing out the host's cloud credentials.
#
# Self-hosted gateways, private deployments and local inference servers are
# supported, but each target must be declared here explicitly. Accepted forms:
#
#     172.19.0.1        exact host
#     172.19.0.0/16     IPv4 CIDR
#     .corp.lan         domain suffix
#     my-gateway        exact hostname
#
# Comma or whitespace separated. Declaring one target does NOT open cloud
# metadata addresses, and it does NOT open the rest of the same subnet.
#
# Examples:
#   ALLOW_PRIVATE_LLM_HOSTS=127.0.0.1
#   ALLOW_PRIVATE_LLM_HOSTS=172.19.0.1, .corp.lan
ALLOW_PRIVATE_LLM_HOSTS=

# --- Trading safety -------------------------------------------------------
# Global kill switch: when true the server refuses to start any trader.
GLOBAL_TRADING_DISABLED=false
# DRY_RUN=true simulates order placement without touching the exchange.
DRY_RUN=false

# --- Deployment version ---------------------------------------------------
# The console shows which commit is deployed and whether it is behind the
# repository. That comparison asks the GitHub API once every 10 minutes, from
# the server. Turn it off on a deployment with no outbound network — the
# console then says "disabled" rather than pretending everything is current.
# UPDATE_CHECK_DISABLED=false

# Optional, only to raise the GitHub API rate limit (60 requests/hour/IP
# unauthenticated). Public repositories do not need it; private ones do.
# It is only ever sent as a request header — never logged, never returned.
# GITHUB_TOKEN=
